node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Project-specific
data/bids/**
!data/bids/.gitkeep

logs/
